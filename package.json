{
  "name": "mealie-mc-bridge",
  "version": "0.1.0",
  "private": false,
  "description": "Send Mealie recipes to a Monsieur Cuisine Smart as guided-cooking drafts",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
