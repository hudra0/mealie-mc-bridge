{
  "description": "Time formulas and mass limits for the validator and the converter. Mass numbers rely on a text heuristic for the bowl content (low to medium confidence); temperature and program defaults rely on many steps (medium to high confidence).",
  "version": 1,
  "source": "corpus 2026-10",
  "constants": {
    "heaterWatts": 1050,
    "efficiency": 0.7,
    "heatCapacityJoulePerKgKelvin": 4200,
    "startTemperatureC": 20,
    "note": "Assumptions for water-like contents, not measurements of the MC Smart."
  },
  "functions": {
    "tMinSeconds": {
      "expression": "massGrams / 1000 * 4200 * (min(temperature, 100) - 20) / (1050 * 0.7)",
      "meaning": "Physical lower bound to bring water-like contents from 20 °C to the target (at most the boiling point).",
      "secondsPerKgToBoil": 457,
      "confidence": "high as a physical bound; ignores lid losses and the control loop"
    },
    "clamp": { "expression": "min(hi, max(lo, x))" }
  },
  "heatUpRules": [
    {
      "id": "heatup_too_short",
      "appliesTo": "first heated manual step since the bowl was filled, temperature >= 90, bowl mass known",
      "condition": "timeSeconds < 0.5 * tMinSeconds(massGrams, temperature)",
      "severity": "error",
      "evidence": "1.6 % of 568 first heatings in the corpus fall below half of tMin."
    },
    {
      "id": "heatup_short",
      "appliesTo": "same as heatup_too_short",
      "condition": "timeSeconds < 0.87 * tMinSeconds(massGrams, temperature)",
      "severity": "warning",
      "typicalFactor": 2.3,
      "evidence": "0.87 is the p10 of time/tMin over 346 official first heatings (median 2.3, median headroom 215 s above tMin)."
    },
    {
      "id": "content_already_hot",
      "appliesTo": "heated step after an earlier heated step without emptying the bowl",
      "condition": "heat up from the mixed temperature of the hot contents and any cold additions; skip the check while that stays at or above the rule temperature",
      "evidence": "43.6 % of such steps are shorter than tMin, as expected for hot contents."
    },
    {
      "id": "mass_unknown",
      "appliesTo": "bowl mass unknown because ingredients are given in pieces or spoons",
      "condition": "convert pieces to grams with units.json pieceWeights first; skip the check when that fails and add a review hint"
    },
    {
      "id": "roasting_not_water",
      "appliesTo": "roasting program",
      "condition": "do not apply the water model; roasting time is fixed by temperature",
      "evidence": "Roasting first heatings: 9.9 % below the water tMin, ratio median 2.81."
    }
  ],
