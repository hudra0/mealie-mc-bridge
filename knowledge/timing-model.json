  "temperatureNotes": [
    "Settings of 105-130 °C with water-based contents are normal practice and not a fault: the contents stay at their boiling point and the setting drives harder boiling and evaporation. Official recipes use them for steaming in manual mode (120 °C, speed 1, steamer fitted), for jam and for reducing with the basket on the lid.",
    "Starch thickens only at 95 °C or more for at least 120 s; yeast at most 37 °C; egg yolk at most 80 °C; milk at most 95 °C (bridge and SmartRecipe rules)."
  ],
  "massEstimation": {
    "method": "Scale steps add their weight unless the text says the weighing happens on a plate on the lid, in the steamer or outside the machine; text steps add listed grams when they name an ingredient with an adding verb; transfer or rinsing empties the bowl. Pieces and spoons count 0 g unless converted.",
    "warning": "The normalizer's cumulativeGramsBefore never decreases and overstates the bowl (median 1460 g at heated steps against 825 g with resets). Do not use it for limits.",
    "bowlAtHeatedSteps": { "median": 825, "p90": 1950 }
  },
  "durations": {
    "totalMinutes": {
      "expression": "14.1 + 0.94 * machineMinutes + 0.63 * passiveMinutes + 1.32 * textSteps + 1.96 * scaleSteps",
      "r2": 0.46,
      "n": 2210,
      "note": "passiveMinutes = oven, proofing, chilling or resting time named in text steps (52 % of recipes have some)."
    },
    "prepMinutes": {
