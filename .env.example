# TCP port the bridge listens on.
PORT=3000
# Interface to bind. Use 0.0.0.0 inside a container.
HOST=0.0.0.0
# Log verbosity: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Device limits the recipe validator enforces. Relative paths resolve against the working directory.
DEVICE_PROGRAMS_PATH=./knowledge/device-programs.json
# Cookie header of a logged-in www.monsieur-cuisine.com browser session. This is a secret:
# whoever has it can change your Monsieur Cuisine recipes. Never commit or share it.
MC_COOKIE=
# Language model that converts recipes: openai or anthropic.
LLM_PROVIDER=openai
# OpenAI API key. A secret, required when LLM_PROVIDER is openai.
OPENAI_API_KEY=
# OpenAI model. Check that your account offers it before relying on the default.
OPENAI_MODEL=gpt-5.5
# OpenAI reasoning effort: none, minimal, low, medium, high, xhigh or max.
OPENAI_REASONING_EFFORT=medium
# Anthropic API key. A secret, required when LLM_PROVIDER is anthropic.
ANTHROPIC_API_KEY=
# Anthropic model.
ANTHROPIC_MODEL=claude-opus-5-5
# Correction rounds after the first answer when the recipe fails the checks (0-10).
LLM_MAX_CORRECTIONS=3
# Knowledge base the converter reads. Relative paths resolve against the working directory.
KNOWLEDGE_DIR=./knowledge
# Optional token prices for the cost estimate, USD per million tokens, as JSON. Overrides
# and extends the built-in table, for example
# {"gpt-5.5": {"input": 5, "cachedInput": 0.5, "output": 30}}
LLM_PRICES_JSON=
