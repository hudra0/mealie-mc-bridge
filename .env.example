# Copy to .env and fill in. Empty values count as unset. Never commit .env.
# README.md, "Configuration reference", lists every variable with its default.
# `docker run --rm ghcr.io/hudra0/mealie-mc-bridge node dist/main.js generate-secrets`
# (or `npx tsx src/main.ts generate-secrets` in a checkout) prints values for
# SETTINGS_KEY and WEBHOOK_TOKEN.

# --- HTTP ---
# TCP port the bridge listens on.
PORT=3000
# Interface to bind. Defaults to 127.0.0.1 (this machine only) and to 0.0.0.0 in the
# Docker image, where the port mapping in compose.yml decides who reaches the bridge. Set
# it only for a local run that other machines must reach.
# HOST=127.0.0.1
# Set by the Docker image; leave it commented out.
# BRIDGE_IN_CONTAINER=1
# Log verbosity: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Time zone for dates in Mealie timeline entries and mails, for example Europe/Berlin.
# The image defaults to UTC. The admin pages use it too.
TZ=

# --- Storage ---
# Directory for bridge.db. Defaults to ./data; the image sets /data. Leave the line
# commented out with Docker: an empty value here would override the image's setting.
# DATA_DIR=./data
# Base64 of 32 random bytes. Encrypts the Monsieur Cuisine cookie and the Lidl account in
# bridge.db. Required. If you lose or change it, enter both again on the admin pages.
SETTINGS_KEY=

# --- Mealie ---
# Secret path segment of the webhook: the recipe action posts to
# http://<bridge-host>:3000/hooks/mealie/<WEBHOOK_TOKEN>. At least 32 characters of
# letters, digits, . _ ~ or -. Required. Every member of your Mealie household can see the
# action URL and use it; the daily limits below cap what that costs.
WEBHOOK_TOKEN=
# How the bridge reaches Mealie, for example http://mealie:9000 inside one compose project.
# Required.
MEALIE_URL=
# API token of the Mealie user the bridge acts as (Profile, API Tokens). A secret. Required.
MEALIE_API_TOKEN=
# How you open Mealie in the browser, for links on the admin page and in mails, for example
# https://mealie.example.com. Defaults to MEALIE_URL.
MEALIE_PUBLIC_URL=
# The part after /g/ in your Mealie recipe URLs, for those links.
MEALIE_GROUP_SLUG=home
# Tag the bridge adds to every recipe it sent.
TAG_NAME=Monsieur Cuisine

# --- Languages ---
# Language of the recipes the bridge writes, and the Monsieur Cuisine settings of that
# language (complexity ids, editor link, proxy language). It needs a locale pack in
# KNOWLEDGE_DIR/locales: de-DE (verified on a device) or en-US (not verified on a device).
MC_LOCALE=de-DE
# Language of the Mealie timeline entries, the mails and the admin pages: de or en.
# Defaults to the language of MC_LOCALE when there are texts for it, else en.
UI_LANGUAGE=

# --- Monsieur Cuisine ---
# What happens to a new recipe: private-publish (saved on your device only, right away) or
# draft (visible in the web editor only; drafts do not show up on the device).
MC_RECIPE_STATUS=private-publish
# How each ingredient gets its systemIngredientId, which the Monsieur Cuisine app uses for
# its shopping list and ingredient filters (the device shows none either way). exact: look
# the name up in the bundled catalog, then in a local cache, then in the Monsieur Cuisine
# ingredient search, and accept only a hit with exactly the same name. off: send every
# ingredient without an id.
MC_RESOLVE_INGREDIENTS=exact
# Hosts the signed image upload URL from Monsieur Cuisine may point to, comma-separated.
# *.example.com covers the subdomains of example.com.
MC_UPLOAD_HOSTS=*.googleapis.com,*.tecpal.com
# Hosts of the Lidl login page, matched exactly. The automatic login types the Lidl account
# only into an https page on one of them.
LIDL_LOGIN_HOSTS=accounts.lidl.com
# Cookie header of a logged-in www.monsieur-cuisine.com browser session. A secret: whoever
# has it can change your Monsieur Cuisine recipes. Optional: the bridge stores it on the
# first start and whenever this value changes; you can paste a new one on the admin page.
# Wrap it in single quotes here, so Compose leaves characters like $ alone.
MC_COOKIE=
# How often the bridge checks the session, in minutes.
SESSION_CHECK_MINUTES=60
# Device limits the recipe validator enforces. Relative paths resolve against the working
# directory.
DEVICE_PROGRAMS_PATH=./knowledge/device-programs.json

# --- Language model ---
# Language model that converts recipes: openai or anthropic.
LLM_PROVIDER=openai
# OpenAI API key. A secret, required when LLM_PROVIDER is openai.
OPENAI_API_KEY=
# OpenAI model. The default is the model the bridge was written against; any Responses API
# model with strict JSON schema support works. Check that your account offers it.
OPENAI_MODEL=gpt-6.1-sol
# OpenAI reasoning effort: none, minimal, low, medium, high, xhigh or max.
OPENAI_REASONING_EFFORT=medium
# Anthropic API key. A secret, required when LLM_PROVIDER is anthropic.
ANTHROPIC_API_KEY=
# Anthropic model; check that your account offers it. The effort is fixed at high.
ANTHROPIC_MODEL=claude-opus-5-5
# Correction rounds after the first answer when the recipe fails the checks (0-10).
LLM_MAX_CORRECTIONS=3
# Knowledge base the converter reads, with the locale packs under locales/<locale>/ (the
# ingredient catalog is locales/<MC_LOCALE>/ingredient-catalog.json). Relative paths
# resolve against the working directory.
KNOWLEDGE_DIR=./knowledge
# Optional token prices for the cost estimate, USD per million tokens, as JSON. Overrides
# and extends the built-in table, for example
# {"gpt-5.5": {"input": 5, "cachedInput": 0.5, "output": 30}}
LLM_PRICES_JSON=
# Largest recipe text sent to the model, in kB. A longer recipe fails its job instead.
LLM_MAX_RECIPE_KB=40

# --- Limits ---
# Jobs the webhook accepts in 24 hours; above it the click is refused and the recipe's
# Mealie timeline says why. 0 turns the limit off.
JOB_DAILY_LIMIT=50
# Estimated model cost in USD of the jobs of the last 24 hours at which the webhook stops
# accepting jobs. 0 turns the limit off.
JOB_DAILY_COST_LIMIT_USD=10

# --- Worker ---
# Seconds between queue polls.
WORKER_POLL_SECONDS=2

# --- Admin pages ---
# The login of the admin pages. Required: the bridge does not start without both. The
# password needs at least 12 characters. It crosses the network in plain text unless a
# TLS reverse proxy is in front (README, "Security").
ADMIN_USER=
ADMIN_PASSWORD=
# off lets the bridge start without ADMIN_USER and ADMIN_PASSWORD. The admin pages are then
# open to anyone who reaches the port; only for a port bound to this machine.
# ADMIN_AUTH=off
# Host names the admin pages answer to, comma-separated, without ports (for example a
# reverse proxy name like bridge.example.com). IP addresses and localhost always work.
# Without a login, other names are refused, which blocks DNS rebinding attacks from
# websites you visit.
ADMIN_HOSTS=
# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto headers the bridge believes:
# false, true, or a comma-separated list of proxy addresses or CIDR ranges such as
# 192.0.2.0/24. Set it behind a reverse proxy, so the login throttle sees the real client
# address and the session cookie gets the Secure flag over HTTPS.
TRUST_PROXY=false

# --- Mail (optional) ---
# smtp:// or smtps:// URL with credentials, for example smtps://user:password@mail.example.com:465.
# Prefer smtps://. smtp:// must upgrade with STARTTLS. Without it, the bridge sends no mail.
SMTP_URL=
# true lets smtp:// send without STARTTLS, password and mails in plain text. Only for a
# mail server on the same host or a trusted network.
SMTP_ALLOW_INSECURE=false
# Recipient of the notifications: expired session, failed jobs, failing session checks.
# Mails are plain text in UI_LANGUAGE.
NOTIFY_EMAIL=
# Sender address. Defaults to NOTIFY_EMAIL.
SMTP_FROM=
