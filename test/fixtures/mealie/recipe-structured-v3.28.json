  "recipeInstructions": [
    {
      "id": "00000000-0000-4000-8000-000000000701",
      "title": "Vorbereiten",
      "summary": "",
      "text": "Zwiebel und Knoblauch schälen und fein hacken. Den Kürbis waschen, entkernen und würfeln.",
      "ingredientReferences": [
        { "referenceId": "00000000-0000-4000-8000-000000000101" },
        { "referenceId": "00000000-0000-4000-8000-000000000102" },
        { "referenceId": "00000000-0000-4000-8000-000000000104" }
      ],
      "noteReferences": []
    },
    {
      "id": "00000000-0000-4000-8000-000000000702",
      "title": "",
      "summary": "Andünsten",
      "text": "Öl in einem Topf erhitzen, Zwiebel und Knoblauch darin 3 Minuten glasig dünsten.",
      "ingredientReferences": [{ "referenceId": "00000000-0000-4000-8000-000000000103" }],
      "noteReferences": []
    },
    {
      "id": "00000000-0000-4000-8000-000000000703",
      "title": "Kochen",
      "summary": "",
      "text": "Kürbis, Linsen und Brühe zugeben und zugedeckt 25 Minuten köcheln lassen.\n\nAnschließend fein pürieren.",
      "ingredientReferences": [
        { "referenceId": "00000000-0000-4000-8000-000000000105" },
        { "referenceId": "00000000-0000-4000-8000-000000000106" }
      ],
      "noteReferences": []
    },
    {
      "id": "00000000-0000-4000-8000-000000000704",
      "title": "",
      "summary": "",
      "text": "Mit Salz abschmecken und mit Kokosmilch, Koriander, Kürbiskernen und Croûtons servieren.",
      "ingredientReferences": [],
      "noteReferences": [{ "referenceId": "00000000-0000-4000-8000-000000000801" }]
    }
