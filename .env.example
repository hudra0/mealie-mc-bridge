# TCP port the bridge listens on.
PORT=3000
# Interface to bind. Use 0.0.0.0 inside a container.
HOST=0.0.0.0
# Log verbosity: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Device limits the recipe validator enforces. Relative paths resolve against the working directory.
DEVICE_PROGRAMS_PATH=./knowledge/device-programs.json
# Cookie header of a logged-in www.monsieur-cuisine.com browser session. This is a secret:
# whoever has it can change your Monsieur Cuisine recipes. Never commit or share it.
MC_COOKIE=
