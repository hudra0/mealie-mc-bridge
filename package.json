{
  "name": "mealie-mc-bridge",
  "version": "0.4.0",
  "private": true,
  "description": "Send Mealie recipes to a Monsieur Cuisine Smart as guided-cooking drafts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hudra0/mealie-mc-bridge"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:assets",
    "build:assets": "tsx scripts/build-assets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dev": "tsx watch src/main.ts",
    "ui:watch": "tsx scripts/build-assets.ts --watch",
    "ui:icons": "tsx scripts/ui-icons.ts",
    "start": "node dist/main.js",
    "corpus:crawl": "tsx scripts/corpus/crawl.ts",
    "corpus:normalize": "tsx scripts/corpus/normalize.ts",
    "corpus:analyze": "tsx scripts/corpus/analyze.ts",
    "corpus:analyze-modes": "tsx scripts/corpus/analyze-modes.ts",
    "corpus:analyze-techniques": "tsx scripts/corpus/analyze-techniques.ts",
    "corpus:analyze-ingredients": "tsx scripts/corpus/analyze-ingredients.ts",
    "corpus:analyze-structure": "tsx scripts/corpus/analyze-structure.ts",
    "corpus:analyze-timing": "tsx scripts/corpus/analyze-timing.ts",
    "corpus:build-knowledge": "tsx scripts/corpus/build-knowledge.ts",
    "mc:smoke": "tsx --env-file-if-exists=.env scripts/mc-smoke.ts",
    "mc:login": "tsx --env-file-if-exists=.env scripts/mc-login.ts",
    "convert": "tsx --env-file-if-exists=.env scripts/convert.ts",
    "convert:eval": "tsx --env-file-if-exists=.env scripts/convert.ts eval",
    "format:check": "tsx scripts/format.ts --check",
    "format": "tsx scripts/format.ts --write",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "hooks:install": "git config core.hooksPath .githooks",
    "docs:config": "tsx scripts/config-reference.ts --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/formbody": "^9.0.1",
    "better-sqlite3": "~12.11.1",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.0",
    "openai": "^7.32.0",
    "pino": "^10.4.0",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "lucide-static": "^1.56.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
