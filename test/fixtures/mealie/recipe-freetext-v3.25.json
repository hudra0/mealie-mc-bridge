  "recipeInstructions": [
    {
      "id": "00000000-0000-4000-8000-000000000721",
      "title": "Teig",
      "summary": "",
      "text": "Hefe in der lauwarmen Milch auflösen.<br>Mit Mehl, Zucker, Salz, Ei und Butter zu einem glatten Teig kneten.",
      "ingredientReferences": []
    },
    {
      "id": "00000000-0000-4000-8000-000000000722",
      "title": "",
      "summary": "Gehen lassen",
      "text": "Zugedeckt an einem warmen Ort 1 Stunde gehen lassen.",
      "ingredientReferences": []
    },
    {
      "id": "00000000-0000-4000-8000-000000000723",
      "title": "Formen und Backen",
      "summary": "",
      "text": "Teig auf der bemehlten Fläche ausrollen, mit Butter bestreichen und mit Zimt, Zucker und Rosinen bestreuen. Aufrollen und in 12 Scheiben schneiden.",
      "ingredientReferences": []
    },
    {
      "id": "00000000-0000-4000-8000-000000000724",
      "title": null,
      "summary": null,
      "text": "",
      "ingredientReferences": []
    },
    {
      "id": "00000000-0000-4000-8000-000000000725",
      "title": "",
      "summary": "",
      "text": "Mit Eigelb und Milch bestreichen, mit Hagelzucker bestreuen und bei 180 °C 20 Minuten backen.",
